# JH Sisyphus — 환경변수 템플릿
# 이 파일을 복사하여 .env 로 저장하고 실제 값을 입력하세요.
# .env 는 절대 git에 커밋하지 마세요.

# ─── Supabase ────────────────────────────────────────────────
# Supabase 프로젝트 URL (Settings > API > Project URL)
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (Settings > API > anon public)
SUPABASE_ANON_KEY=your-anon-key-here

# ─── 프로젝트 설정 ───────────────────────────────────────────
PROJECT_NAME=JH Sisyphus

# ─── Supabase 필요 테이블 생성 SQL ──────────────────────────
# Supabase SQL Editor에서 아래 SQL을 실행하세요:
#
# create table agent_logs (
#   id uuid default gen_random_uuid() primary key,
#   agent text not null,
#   state text not null,
#   todo text,
#   message text,
#   wave text,
#   ts timestamptz default now()
# );
# alter publication supabase_realtime add table agent_logs;
#
# create table todos (
#   id uuid default gen_random_uuid() primary key,
#   session_id text not null,
#   content text not null,
#   status text default 'pending',
#   agent text,
#   created_at timestamptz default now(),
#   updated_at timestamptz default now()
# );
# alter publication supabase_realtime add table todos;
